{
  "name": "@globalcaos/tinker-learned-intuition",
  "version": "0.1.2",
  "description": "A deterministic safety floor plus a novelty sense that habituates. Observes by default (AEGIS included); blocking and pre-execution enforcement are opt-in.",
  "keywords": [
    "openclaw",
    "openclaw-plugin"
  ],
  "homepage": "https://thetinkerzone.com",
  "bugs": {
    "url": "https://github.com/globalcaos/tinkerclaw/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "globalcaos",
    "url": "https://thetinkerzone.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalcaos/tinkerclaw.git",
    "directory": "extensions/tinkerclaw-learned-intuition"
  },
  "files": [
    "index.ts",
    "dist/",
    "src/",
    "hook/",
    "openclaw.plugin.json",
    "README.md",
    "models/amygdala/checkpoints/prudence_*.pt",
    "models/amygdala/onnx/prudence_*.onnx",
    "models/amygdala/prudence-*.onnx"
  ],
  "type": "module",
  "dependencies": {
    "onnxruntime-node": "^1.26.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.25"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.4.25"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": true
    },
    "build": {
      "openclawVersion": "2026.4.25"
    }
  }
}
