{
  "name": "@globalcaos/tinker-fractal-reflection",
  "version": "0.1.2",
  "description": "A separate read-only agent grades each finished turn out of band, with evidence it re-checks against disk. Opt-in; one subagent run per turn.",
  "keywords": [
    "openclaw",
    "openclaw-plugin"
  ],
  "homepage": "https://thetinkerzone.com",
  "bugs": {
    "url": "https://github.com/globalcaos/tinkerclaw/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "globalcaos",
    "url": "https://thetinkerzone.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalcaos/tinkerclaw.git",
    "directory": "extensions/tinkerclaw-fractal-reflection"
  },
  "files": [
    "index.ts",
    "dist/index.js",
    "src/action-claims.ts",
    "src/fractal-result.ts",
    "src/fractal-run.ts",
    "src/governor.ts",
    "src/ledger.ts",
    "src/types.ts",
    "triage-prompt.md",
    "openclaw.plugin.json",
    "README.md"
  ],
  "type": "module",
  "peerDependencies": {
    "openclaw": ">=2026.4.25"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.4.25"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    },
    "build": {
      "openclawVersion": "2026.4.25"
    }
  }
}
