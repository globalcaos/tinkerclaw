  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalcaos/tinkerclaw.git",
    "directory": "extensions/tinkerclaw-memory-enhancements"
  },
  "files": [
    "index.ts",
    "src/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "type": "module",
  "peerDependencies": {
