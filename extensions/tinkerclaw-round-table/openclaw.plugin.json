{
  "id": "tinkerclaw-round-table",
  "activation": {
    "onStartup": true
  },
  "name": "Round Table",
  "description": "SYNAPSE \u2014 Multi-model debate via RAAC protocol with cognitive diversity scoring. Makes cheap models smarter than expensive ones.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultDepth": {
        "type": "string",
        "enum": ["quick", "standard", "deep"],
        "default": "standard"
      },
      "maxRounds": {
        "type": "number",
        "default": 6
      }
    }
  }
}
