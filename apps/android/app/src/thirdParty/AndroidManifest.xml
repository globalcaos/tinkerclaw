<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- FORK 2026-10-19 (the architect: phone app) — what the Jarvis build adds: the jarvis://pair deep
         link (one MainActivity instance, so the link lands in the running app), the self-updater
         (install permission + the PackageInstaller status receiver) and vibrate() for the page's
         JarvisNative bridge. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 2026-10-22: the agent may update the app at any time. Lets the
         installer of record update itself with no confirmation screen (Android 12+). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 2026-10-27: the app kept stopping. Android 15 caps dataSync at 6 h a day and every wake
         after that crashed the app, so the always-connected Jarvis build runs its node service as specialUse. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Loopback cleartext only in a JARVIS_DEV build (see build.gradle.kts). -->
    <application
        android:networkSecurityConfig="${jarvisNetworkSecurityConfig}"
        tools:replace="android:networkSecurityConfig">
        <activity
            android:name="ai.openclaw.app.MainActivity"
            android:launchMode="singleTask"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="jarvis" />
            </intent-filter>
        </activity>
        <service
            android:name="ai.openclaw.app.NodeForegroundService"
            android:foregroundServiceType="specialUse|microphone"
            tools:replace="android:foregroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's personal assistant connected to their home server" />
        </service>
        <receiver
            android:name="ai.openclaw.app.update.AppUpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
