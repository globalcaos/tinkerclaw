#!/usr/bin/env bash
# FORK 2026-05-11/12 — pre-push gate for the public fork.
#
# Four gates run in order; all must pass or the push is blocked:
#   1. PII leak grep (scripts/pii-pre-push.sh) — bypass: PII_GUARD=off
#   2. Bible invariants (pnpm bible:invariants) — bypass: BIBLE_GUARD=off
#   3. Recurring-pattern linter (scripts/lint-recurring-patterns.mjs)
#      — bypass: PATTERN_LINT=off
#   4. plugin-sdk export integrity — bypass: SDK_EXPORTS_GUARD=off
#      (src→entrypoints manifest drift + manifest→package.json drift;
#      catches the 2026-05-21 tinker-bridge-can't-load-because-export-missing
#      class that bricked the gateway on restart)
#
# The invariants runner is tolerant of "gateway down" and "gateway stale"
# (running on an older dist than HEAD). Those count as SKIP, not FAIL. A
# real contract regression (file missing, grep doesn't match, RPC shape
# changed) still blocks the push.

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PII_SCRIPT="$ROOT_DIR/scripts/pii-pre-push.sh"

# Gate 1 — PII leak grep
if [[ ! -x "$PII_SCRIPT" ]]; then
  echo "[pre-push] missing: $PII_SCRIPT (run chmod +x and try again)" >&2
  exit 1
fi
# Capture stdin since the PII script reads the pre-push line format from it.
PII_INPUT="$(cat)"
if ! echo "$PII_INPUT" | "$PII_SCRIPT" "$@"; then
  exit 1
fi

# Gate 2 — bible invariants merge gate
if [[ "${BIBLE_GUARD:-}" == "off" ]]; then
  echo "[bible:invariants] BIBLE_GUARD=off — skipping merge gate (bypass acknowledged)" >&2
else
  echo "[pre-push] running bible:invariants…" >&2
  # cd to repo root so node + pnpm find the right project. The runner exits 0
  # on all-pass OR all-skip-because-gateway-down; non-zero only on real fails.
  if ! (cd "$ROOT_DIR" && pnpm bible:invariants); then
    echo "" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
    echo "🛑 BLOCKED: bible:invariants failed" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
    echo "" >&2
    echo "A J15 contract regressed. Run 'pnpm bible:invariants' to see the" >&2
    echo "full failure list, then either fix the regression or update the" >&2
    echo "bible verify entry to reflect the intentional change." >&2
    echo "" >&2
    echo "Bypass (for intentional WIP pushes to develop): BIBLE_GUARD=off git push" >&2
    exit 1
  fi
fi

# Gate 3 — recurring-pattern linter (FORK 2026-05-12)
# Catches code shapes that match historical bug-log.md classes
# (ui-state-clear ×7, more to come). Fast (<2s); always-on; bypasses are
# explicit when a developer intentionally adds a new instance with a
# "preserve" comment.
if [[ "${PATTERN_LINT:-}" == "off" ]]; then
  echo "[pattern-lint] PATTERN_LINT=off — skipping (bypass acknowledged)" >&2
else
  if [[ -x "$ROOT_DIR/scripts/lint-recurring-patterns.mjs" ]]; then
    if ! node "$ROOT_DIR/scripts/lint-recurring-patterns.mjs"; then
      echo "" >&2
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
      echo "🛑 BLOCKED: recurring-pattern linter found a historical bug shape" >&2
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
      echo "" >&2
      echo "See bug-log.md for the failure-class taxonomy. Bypass with" >&2
      echo "    PATTERN_LINT=off git push" >&2
      echo "only if the diff is intentional AND you've added a preserve comment." >&2
      exit 1
    fi
  fi
fi

# Gate 4 — plugin-sdk export integrity (FORK 2026-05-21)
# Catches the failure-class that bricked the tinker-bridge plugin on 2026-05-21:
# a src/plugin-sdk/*.ts file existed without a matching entry in
# scripts/lib/plugin-sdk-entrypoints.json + package.json#exports, so the
# gateway exploded on plugin-load with "Cannot find module '.../dist/...'".
#
# Two sub-checks:
#   a) src→manifest drift — every "@openclaw/openclaw/plugin-sdk/<name>"
#      import in src/extensions/scripts/test must be listed in either the
#      entrypoints manifest or the private-local-only list.
#   b) manifest→package.json drift — package.json#exports must contain one
#      ./plugin-sdk/<name> entry per entrypoint.
if [[ "${SDK_EXPORTS_GUARD:-}" == "off" ]]; then
  echo "[sdk-exports] SDK_EXPORTS_GUARD=off — skipping (bypass acknowledged)" >&2
else
  SDK_EXPORTS_FAILED=0
  if ! (cd "$ROOT_DIR" && node scripts/check-plugin-sdk-subpath-exports.mjs); then
    SDK_EXPORTS_FAILED=1
  fi
  if ! (cd "$ROOT_DIR" && node scripts/sync-plugin-sdk-exports.mjs --check); then
    SDK_EXPORTS_FAILED=1
  fi
  if [[ "$SDK_EXPORTS_FAILED" -ne 0 ]]; then
    echo "" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
    echo "🛑 BLOCKED: plugin-sdk exports out of sync" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
    echo "" >&2
    echo "A src/plugin-sdk import has no matching entrypoint, or the" >&2
    echo "entrypoints manifest doesn't match package.json#exports. The" >&2
    echo "gateway will fail to load the dependent plugin on next restart." >&2
    echo "" >&2
    echo "Fix:  pnpm plugin-sdk:sync-exports  (and add the missing entry to" >&2
    echo "      scripts/lib/plugin-sdk-entrypoints.json if needed)." >&2
    echo "" >&2
    echo "Bypass (only if you know what you're doing): SDK_EXPORTS_GUARD=off git push" >&2
    exit 1
  fi
fi
