{
  "mcpServers": {
    "jarvis": {
      "type": "http",
      "url": "${JARVIS_GATEWAY_URL:-http://127.0.0.1:18789/mcp}",
      "headers": {
        "Authorization": "Bearer ${OPENCLAW_GATEWAY_TOKEN}",
        "x-session-key": "${JARVIS_SESSION_KEY:-agent:main:main}",
        "x-openclaw-agent-id": "${JARVIS_AGENT_ID:-main}",
        "x-openclaw-message-channel": "claude-code-plugin"
      }
    }
  }
}
